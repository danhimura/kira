{
  "name": "aymi",
  "version": "0.1.0",
  "description": "Local desktop AI agent runtime (2D avatar + voice) - Agent Runtime core",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "eval": "tsx --env-file-if-exists=.env src/evaluation/run.ts",
    "server": "tsx --env-file-if-exists=.env src/server.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "uuid": "^11.0.0",
    "ws": "^8.21.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "sharp": "^0.35.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
